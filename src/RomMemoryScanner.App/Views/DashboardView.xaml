<UserControl x:Class="RomMemoryScanner.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="16" Margin="0,0,0,8">
            <Run Text="Tracked values" />
            <Run Text=" — " />
            <Run Text="{Binding GameTitle, Mode=OneWay, TargetNullValue='(no game loaded)'}" />
        </TextBlock>

        <Expander DockPanel.Dock="Bottom" Header="Audit log (every live write, per session)" Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding AuditLog}" Height="140" FontFamily="Consolas" FontSize="11" />
        </Expander>

        <Expander DockPanel.Dock="Top" Header="Add an address manually (already know it? skip Live Scan)" Margin="0,0,0,8" IsExpanded="False">
            <StackPanel Margin="8">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Label:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Grid.Column="1" Text="{Binding ManualLabel, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="Address (hex):" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <TextBox Grid.Column="3" Text="{Binding ManualAddressHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    <TextBlock Grid.Column="4" Text="Type:" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox Grid.Column="5" ItemsSource="{Binding AvailableDataTypes}" SelectedItem="{Binding ManualDataType}" />
                    <TextBlock Grid.Column="6" Text="Byte order:" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <ComboBox Grid.Column="7" ItemsSource="{Binding AvailableByteOrders}" SelectedItem="{Binding ManualByteOrder}" />
                </Grid>
                <Button Content="Add" Command="{Binding AddManualCommand}" HorizontalAlignment="Left" Padding="16,4" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ManualEntryError}" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Label" Binding="{Binding Label}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Header="Address" Binding="{Binding AddressHex}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="Type" Binding="{Binding DataType}" IsReadOnly="True" Width="80" />
                <DataGridTextColumn Header="Hex" Binding="{Binding HexText, UpdateSourceTrigger=LostFocus}" Width="90" />
                <DataGridTextColumn Header="Decimal" Binding="{Binding DecimalText, UpdateSourceTrigger=LostFocus}" Width="90" />
                <DataGridCheckBoxColumn Header="Live" Binding="{Binding IsLive}" IsReadOnly="True" Width="50" />
                <DataGridCheckBoxColumn Header="Freeze" Binding="{Binding IsFrozen}" Width="60" />
                <DataGridTextColumn Header="Error" Binding="{Binding LastError}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
