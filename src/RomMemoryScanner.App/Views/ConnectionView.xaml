<UserControl x:Class="RomMemoryScanner.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">

        <TextBlock Text="RetroArch connection" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="Enable Settings &gt; Network &gt; Network Commands in RetroArch first. This is the preferred, sanctioned integration path (FR-6.1) — no process-memory hacking involved." />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="4" Content="Connect" Command="{Binding ConnectCommand}" Margin="12,0,0,0" Padding="12,2" />
        </Grid>

        <TextBlock Margin="0,0,0,4">
            <Run Text="RetroArch process detected: " />
            <Run Text="{Binding RetroArchProcessDetected, Mode=OneWay}" FontWeight="Bold" />
        </TextBlock>
        <TextBlock Margin="0,0,0,16">
            <Run Text="Version: " />
            <Run Text="{Binding RetroArchVersion, Mode=OneWay}" FontWeight="Bold" />
        </TextBlock>

        <Separator Margin="0,0,0,16" />

        <TextBlock Text="Load a ROM to identify it" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding RomPath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Browse..." Click="BrowseButton_Click" Margin="8,0,0,0" Padding="12,2" />
            <Button Grid.Column="2" Content="Identify" Command="{Binding IdentifyRomCommand}" Margin="8,0,0,0" Padding="12,2" />
        </Grid>

        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Console (auto-detected; override if wrong):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableConsoles}" SelectedItem="{Binding SelectedConsole}" />
        </Grid>

        <TextBlock Margin="0,0,0,4">
            <Run Text="CRC32: " />
            <Run Text="{Binding RomChecksum.Crc32, Mode=OneWay}" FontFamily="Consolas" />
        </TextBlock>
        <TextBlock Margin="0,0,0,4">
            <Run Text="MD5: " />
            <Run Text="{Binding RomChecksum.Md5, Mode=OneWay}" FontFamily="Consolas" />
        </TextBlock>
        <TextBlock Margin="0,0,0,4">
            <Run Text="Matched database entry: " />
            <Run Text="{Binding MatchedGame.Title, Mode=OneWay, TargetNullValue='(none)'}" FontWeight="Bold" />
        </TextBlock>

    </StackPanel>
</UserControl>
