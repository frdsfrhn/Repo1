<Window x:Class="RomMemoryScanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RomMemoryScanner.App.Views"
        Title="ROM Memory Scanner &amp; Cheat Code Generator"
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Connection.StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">
            <TabItem Header="1. Game / Process">
                <views:ConnectionView DataContext="{Binding Connection}" />
            </TabItem>
            <TabItem Header="2. Live Scan (Phase 2)">
                <views:LiveScanView DataContext="{Binding LiveScan}" />
            </TabItem>
            <TabItem Header="3. Dashboard">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="4. Cheat Codes">
                <views:CheatCodeView DataContext="{Binding CheatCode}" />
            </TabItem>
            <TabItem Header="5. Address Database">
                <views:DatabaseBrowserView DataContext="{Binding DatabaseBrowser}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
