<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <AssemblyName>RomMemoryScanner</AssemblyName>
    <RootNamespace>RomMemoryScanner.App</RootNamespace>
    <!-- Built on Linux/CI for compile validation only; WPF requires Windows to run. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomMemoryScanner.Core\RomMemoryScanner.Core.csproj" />
  </ItemGroup>

  <!-- Ship the address database next to the built exe so GameDatabaseService finds it at AppContext.BaseDirectory\database. -->
  <ItemGroup>
    <Content Include="..\..\database\**\*.json">
      <Link>database\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
